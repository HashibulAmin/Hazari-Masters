rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hasibul.amin.hemel@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Live Game Tables Collection
    match /tables/{tableId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Completed Games Archive Collection
    match /completed_games/{gameId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Game Invites Collection
    match /invites/{inviteId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // User Personal AI Models Collection
    match /user_models/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Daily Missions Collection
    match /user_missions/{missionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
  }
}
